KUMA_ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./.kuma/kuma.db
KUMA_ENCRYPTION_KEY=
KUMA_ENCRYPTION_KEY_FILE=.kuma/encryption.key
KUMA_REQUIRE_DEVICE_AUTH=false
KUMA_SESSION_COOKIE_NAME=kuma_session
KUMA_SESSION_COOKIE_DOMAIN=
KUMA_SESSION_COOKIE_SECURE=false
KUMA_SESSION_DAYS=30
KUMA_PAIRING_MINUTES=10
KUMA_STUDIO_URL=http://localhost:3001/studio
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2
OPENROUTER_TTS_VOICE=en-US-Harper:MAI-Voice-2
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
EXA_API_KEY=
NOTION_API_KEY=
NOTION_NOTES_PAGE_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=UTC
KUMA_API_TOKEN=
KUMA_SYSTEM_PROMPT=You are Kuma Voice, a concise, warm voice assistant. Keep answers brief and easy to understand when spoken aloud.
KUMA_MAX_AUDIO_BYTES=10485760
